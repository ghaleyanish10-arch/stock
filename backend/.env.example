# ---------------------------------------------------------------------------
# NEPSE service configuration (copy to .env and adjust; never commit .env)
# ---------------------------------------------------------------------------

# Host/port the service listens on (uvicorn)
NEPSE_HOST=127.0.0.1
NEPSE_PORT=8000

# Per-request timeout (seconds) for NEPSE API calls
NEPSE_TIMEOUT=15

# Time-to-live (seconds) for the service-level response cache
NEPSE_CACHE_TTL=30

# How long a cached NEPSE failure ("service down") is remembered before retrying
NEPSE_ERROR_TTL=60

# Log level: DEBUG | INFO | WARNING | ERROR
NEPSE_LOG_LEVEL=INFO

# Nepal time (HH:MM, 24h) at which the post-close snapshot fetches the final
# session figures. NEPSE closes at 15:00 NPT and publishes the final data
# shortly after, so 15:30 gives the exchange time to settle. A run that happened
# BEFORE this time does not count as done: the scheduler comes back afterwards
# and overwrites the partial rows with the real close. Leave unset to use 15:30.
# APP_POST_CLOSE_HHMM=15:30
